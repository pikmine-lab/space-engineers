# Copy to .env, which is git-ignored, and fill in.
#
# This repository is public: anything that names a machine or a person lives
# here and never in a committed file.

# Dokploy dashboard the provisioner talks to.
DOKPLOY_URL=https://dokploy.example.com

# Dokploy API token. Optional: when unset, the provisioner falls back to
# ~/.config/dokploy/token, which the infra repository already uses.
# DOKPLOY_AUTH_TOKEN=

# Server administrators, comma-separated Steam64 ids. Your id is the number in
# your profile URL: steamcommunity.com/profiles/<id>
# Reapplied to the server configuration on every start, so this list is the
# only place administrators are declared.
SE_ADMINS=
